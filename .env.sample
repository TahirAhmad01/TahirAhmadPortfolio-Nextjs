# -------------------------------------------------------------
# EmailJS Setup (Client-side contact form fallback)
# Website: https://www.emailjs.com/
# -------------------------------------------------------------
NEXT_PUBLIC_EMAIL_JS_SERVICE_ID=""
NEXT_PUBLIC_EMAIL_JS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAIL_JS_PUBLIC_KEY=""

# -------------------------------------------------------------
# SMTP Email Setup (Server-side API contact endpoint: /api/contact)
# -------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
CONTACT_RECEIVER_EMAIL="your-email@gmail.com"

# -------------------------------------------------------------
# AI Assistant Setup (Server-side chatbot API endpoint: /api/chat)
# Google AI Studio: https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=""
